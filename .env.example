# NextBestContent configuration
# Copy this file to .env.local. Never commit populated credentials.

# Runtime profile. These values are server-only and must be explicit in
# production. Installation is advisory UI/runtime metadata, not access control.
APP_PROFILE=public_demo
APP_INSTALLATION=private

# OpenAI Responses API
# Server-managed credentials are self-hosted only and require both values.
ENABLE_SERVER_LLM_KEY=false
LLM_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_INPUT_CHARS=600000

# Optional request-scoped key support. Keep off unless the deployment has
# reviewed its transport, logging, abuse-prevention, and privacy controls.
ENABLE_OPENAI_BYOK=false

# YouTube Data API (both gates must remain false until policy approval)
ENABLE_YOUTUBE_API=false
YOUTUBE_POLICY_APPROVED=false
YOUTUBE_API_KEY=

# Optional n8n rendering handoff
ENABLE_N8N=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional ElevenLabs narration
ENABLE_ELEVENLABS=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional fal media generation
ENABLE_FAL=false
FAL_KEY=
