# NextBestContent configuration
# Copy this file to .env.local. Never commit populated credentials.

# OpenAI-compatible model provider
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
ENABLE_SERVER_LLM_KEY=false
LLM_API_KEY=

# YouTube Data API (both gates must remain false until policy approval)
ENABLE_YOUTUBE_API=false
YOUTUBE_POLICY_APPROVED=false
YOUTUBE_API_KEY=

# Optional n8n rendering handoff
ENABLE_N8N=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional ElevenLabs narration
ENABLE_ELEVENLABS=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional fal media generation
ENABLE_FAL=false
FAL_KEY=
